# Copy to .env (never commit .env). With DEMO_MODE=true everything runs offline on synthetic data.
# You can also connect a model from the app itself ("Connect a model" in the sidebar): that key stays in the
# browser session's memory and is never saved. The variables below connect a model for the whole server.
DEMO_MODE=true

# Server-wide model (only used when DEMO_MODE=false)
LLM_PROVIDER=anthropic          # anthropic (Claude), openai (OpenAI, Codex, compatible / local model), claude-cli or codex-cli
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5       # for openai, e.g. gpt-5 or the name your local server uses
# LLM_BASE_URL=http://localhost:11434/v1   # openai provider only: a local model (Ollama, LM Studio) needs no key

# Optional
# BUSFACTOR_DB=busfactor.db            # SQLite file (in Docker: /data/busfactor.db)
# BUSFACTOR_UPLOADS=uploads            # folder for uploaded project documents
# BUSFACTOR_REMINDER_DAYS=2            # idle accepted mission -> reminder
# BUSFACTOR_FOLLOWUP_DAYS=3            # days after a passed retest before the follow-up question
# BUSFACTOR_ALLOW_PRIVATE_LLM_URLS=false   # allow a model on a private network (default: blocked)
# BUSFACTOR_PALETTE=brass               # brass (default), classic, forest, teal, rose, mono, bordeaux, olive, slate
# BUSFACTOR_ENABLE_LOCAL_CLI=false      # true: allow the Claude Code / Codex CLI providers (your own computer only)
